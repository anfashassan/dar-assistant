# Required: free key from https://openrouter.ai/keys (no credit card needed for :free models)
OPENROUTER_API_KEY=sk-or-v1-...

# Optional: pin models (comma separated). Empty = auto-discover current free models.
# OPENROUTER_MODELS=nvidia/nemotron-3-ultra-550b-a55b:free,google/gemma-4-31b-it:free

# Public URL of the deployment (sent to OpenRouter as HTTP-Referer)
APP_URL=http://localhost:7860

# Data refresh: re-scrape inside the container every N hours (0 = off)
REFRESH_INTERVAL_H=24
# Token for POST /api/admin/refresh (manual re-scrape). Leave empty to disable.
ADMIN_TOKEN=

# Tuning (defaults shown)
# TOP_K=6
# MAX_LISTINGS=6
# MAX_TOKENS=900
# TEMPERATURE=0.2
# RATE_LIMIT_PER_MIN=12
# CACHE_TTL_S=3600
